# 正式域名，例如 https://example.com
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# 同区域自托管 Umami；未配置时不加载统计脚本
NEXT_UMAMI_ID=
NEXT_PUBLIC_UMAMI_SRC=

# 咨询通知 Webhook；未配置时表单只做校验并引导微信/QQ
CONSULTATION_WEBHOOK_URL=

# 国内搜索平台验证
BAIDU_SITE_VERIFICATION=
BING_SITE_VERIFICATION=

# 百度普通收录 API（执行 yarn submit:baidu 时使用）
BAIDU_SITE=
BAIDU_PUSH_TOKEN=
